; Engine configuration file. Edit through the editor where possible.

config_version=5

[accessibility]

general/accessibility_support=0

[application]

config/name="Cliamp"
config/description="Desktop client for the cliamp music player."
run/main_scene="res://ui/main.tscn"
run/low_processor_mode=true
config/use_custom_user_dir=true
config/custom_user_dir_name="cliamp"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon/icon.svg"
config/windows_native_icon="res://icon/icon.ico"
config/macos_native_icon="res://icon/icon.icns"

[audio]

driver/driver="Dummy"

[autoload]

ThemeBuilder="*res://autoload/theme_builder.gd"
Backend="*res://autoload/backend.gd"
Prefs="*res://autoload/prefs.gd"
Store="*res://autoload/store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/mode="disabled"

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
