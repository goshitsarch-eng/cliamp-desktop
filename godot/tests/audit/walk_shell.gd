extends AuditKit
## Clicks the sidebar, top bar, player bar and shortcuts like a user would.


func run() -> void:
	var wav := OS.get_environment("SHOT_WAV")
	await Store.run("sources.load", {"args": [wav], "name": "replace", "play": false, "if_revision": Store.state.get("playlist_revision", 0)})
	await set_size(1280, 800)
	await wait(0.5)

	# Sidebar
	for page: Dictionary in Pages.LIST:
		var target := by_name(page["label"])
		await click(target)
		await wait(0.5)
		check(Store.current_page == page["id"], "sidebar opens " + page["id"])
		lint("sidebar-" + page["id"])

	# Search box
	await click_name("Queue")
	var search := by_name("Search")
	await click(search)
	check(get_viewport().gui_get_focus_owner() == search, "search takes focus on click")
	await type_text("ton")
	check((search as LineEdit).text == "ton", "typing fills search (%s)" % (search as LineEdit).text)
	check(Store.filter == "ton", "filter published")
	await shot("search_ton")
	await key(KEY_ESCAPE)
	check((search as LineEdit).text == "", "Escape clears search")
	await click(search)
	await type_text("zzzqq")
	await wait(0.4)
	await shot("search_nomatch")
	await key(KEY_ESCAPE)

	# Top bar buttons
	await click_name("Background activity")
	await wait(0.5)
	check(not dialogs().is_empty(), "jobs panel opens")
	await shot_dialogs("jobs")
	await close_dialogs()
	await click_name("Keyboard shortcuts and commands")
	await wait(0.5)
	check(not dialogs().is_empty(), "palette opens")
	await shot_dialogs("palette")
	await close_dialogs()
	await click_name("Add music")
	await wait(0.6)
	check(not dialogs().is_empty(), "add music dialog opens")
	await shot_dialogs("addmusic")
	await close_dialogs()

	# Shortcuts
	await click_name("Queue")
	await key(KEY_K, true)
	await wait(0.4)
	check(not dialogs().is_empty(), "Ctrl+K palette")
	await close_dialogs()
	await key(KEY_F1)
	await wait(0.4)
	check(not dialogs().is_empty(), "F1 palette")
	await close_dialogs()
	await key(KEY_O, true)
	await wait(0.4)
	check(not dialogs().is_empty(), "Ctrl+O add")
	await close_dialogs()
	await key(KEY_F, true)
	check(get_viewport().gui_get_focus_owner() == by_name("Search"), "Ctrl+F focuses search")
	await key(KEY_ESCAPE)
	await key(KEY_J, true)
	await wait(0.4)
	await shot_dialogs("jump")
	await close_dialogs()
	await key(KEY_X, true)
	await wait(0.4)
	await shot("compact")
	await key(KEY_ESCAPE)
	await wait(0.3)
	await key(KEY_SPACE)
	await wait(0.8)
	check(Store.is_playing(), "Space starts playback")
	await key(KEY_SPACE)
	await wait(0.6)
	check(not Store.is_playing(), "Space pauses")

	# Player bar
	var vol0 := Util.number(Store.state.get("volume"))
	await key(KEY_DOWN, true)
	await wait(0.5)
	check(Util.number(Store.state.get("volume")) < vol0, "Ctrl+Down lowers volume")
	await key(KEY_UP, true)
	await click_name("Play")
	await wait(0.8)
	check(Store.is_playing(), "Play button plays")
	await click_name("Pause")
	await wait(0.6)
	check(not Store.is_playing(), "Pause button pauses")
	await click_name("Shuffle")
	await wait(0.5)
	check(Store.state.get("shuffle") == true, "shuffle on (%s)" % str(Store.state))
	await click_name("Shuffle")
	await click_name("Repeat: Off")
	await wait(0.5)
	check(str(Store.state.get("repeat")) != "Off", "repeat cycles (%s)" % str(Store.state.get("repeat")))
	await click_name("Repeat: " + str(Store.state.get("repeat")))
	await click_name("Repeat: " + str(Store.state.get("repeat")))
	await wait(0.4)
	await click_name("Favorite current track")
	await wait(0.8)
	await shot("after_favorite")
	await click_name("Playback speed")
	await wait(0.4)
	await shot_dialogs("speed_menu")
	await key(KEY_ESCAPE)
	await click_name("Playback options")
	await wait(0.4)
	await shot_dialogs("more_menu")
	await key(KEY_ESCAPE)
	await click_name("Minimum volume")
	await wait(0.5)
	check(Util.number(Store.state.get("volume")) <= -49.0, "volume icon mutes")
	await click_name("Restore volume")
	await wait(0.5)
	check(Util.number(Store.state.get("volume")) >= -0.5, "volume restores")
	await click_name("Download current track")
	await wait(1.0)
	await shot_dialogs("download")
	await close_dialogs()
	await click_name("Show lyrics")
	await wait(0.6)
	check(Store.current_page == "lyrics", "lyrics button opens lyrics")
	await shot("lyrics_nolyrics")
